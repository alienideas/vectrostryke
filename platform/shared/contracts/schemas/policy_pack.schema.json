{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectorstryke.local/schemas/policy_pack.schema.json",
  "title": "VS Policy Pack",
  "description": "Signed policy data. schema_version 1.0.0",
  "type": "object",
  "required": ["schema_version", "id", "version", "signature", "thresholds", "approval"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "signature": {
      "type": "object",
      "required": ["alg", "value"],
      "properties": {
        "alg": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "rules": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "thresholds": {
      "type": "object",
      "required": ["observe_max", "auto_act_min"],
      "properties": {
        "observe_max": { "type": "number" },
        "auto_act_min": { "type": "number" }
      },
      "additionalProperties": true
    },
    "location_windows": { "type": "array", "items": { "type": "object" } },
    "hardening": { "type": "object", "additionalProperties": true },
    "playbooks": { "type": "array", "items": { "type": "object" } },
    "approval": {
      "type": "object",
      "required": ["impact_force", "timeout_sec", "fallback"],
      "properties": {
        "impact_force": { "type": "boolean" },
        "timeout_sec": { "type": "integer", "minimum": 1 },
        "fallback": {
          "type": "string",
          "enum": ["auto_act", "escalate", "observe"]
        }
      }
    }
  }
}
