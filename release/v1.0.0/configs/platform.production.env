# VectorStryke production environment (template — do not commit secrets)
VS_ENV=production
VS_SCHEMA_VERSION=1.0.0
VS_PACK_KEY_PATH=/etc/vectorstryke/keys/pack.key
VS_REQUIRE_SIGNED_PACKS=true
VS_OFFLINE_OK=true
VS_LOG_LEVEL=INFO
VS_ASG_CONFIG=/etc/vectorstryke/asg.production.json
VS_HEALTH_PORT=8790
